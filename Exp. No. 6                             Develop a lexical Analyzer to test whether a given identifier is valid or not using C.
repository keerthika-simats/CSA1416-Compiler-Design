#include <stdio.h>
#include <ctype.h>

int main()
{
    char a[20];
    int i, flag = 1;

    printf("Enter an identifier: ");
    scanf("%s", a);

    if (!isalpha(a[0]))
        flag = 0;

    for (i = 1; a[i] != '\0'; i++)
    {
        if (!isalnum(a[i]))
        {
            flag = 0;
            break;
        }
    }

    if (flag)
        printf("Valid Identifier");
    else
        printf("Invalid Identifier");

    return 0;
}
