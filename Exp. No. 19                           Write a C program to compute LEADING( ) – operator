#include <stdio.h>

char lead[10][10];
int n = 0;

void add(char nt, char t)
{
    int i;

    for(i = 0; i < 10; i++)
        if(lead[nt-'A'][i] == t)
            return;

    lead[nt-'A'][n++] = t;
}

