#include <stdio.h>
#include <string.h>

char input[100];
int i = 0;

int E();
int EP();
int T();
int TP();
int F();

int E()
{
    return T() && EP();
}

int EP()
{
    if(input[i] == '+')
    {
        i++;
        return T() && EP();
    }
    return 1;
}

int T()
{
    return F() && TP();
}

int TP()
{
    if(input[i] == '*')
    {
        i++;
        return F() && TP();
    }
    return 1;
}

int F()
{
    if(input[i] == '(')
    {
        i++;
        if(E() && input[i] == ')')
        {
            i++;
            return 1;
        }
        return 0;
    }

    if((input[i] >= 'a' && input[i] <= 'z') ||
       (input[i] >= 'A' && input[i] <= 'Z'))
    {
        i++;
        return 1;
    }

    return 0;
}

int main()
{
    printf("Grammar:\n");
    printf("E -> TE'\n");
    printf("E' -> +TE' | e\n");
    printf("T -> FT'\n");
    printf("T' -> *FT' | e\n");
    printf("F -> (E) | ID\n");

    printf("\nEnter string: ");
    scanf("%s", input);

    if(E() && input[i] == '\0')
        printf("String is accepted");
    else
        printf("String is not accepted");

    return 0;
}
