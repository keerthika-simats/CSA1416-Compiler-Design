#include <stdio.h>
#include <ctype.h>
#include <string.h>

char p[10][10];
int n, x = 0;
char result[20];

void add(char c)
{
    int i;
    for(i = 0; i < x; i++)
        if(result[i] == c)
            return;

    result[x++] = c;
}

void FIRST(char c)
{
    int i;

    if(!isupper(c))
    {
        add(c);
        return;
    }

    for(i = 0; i < n; i++)
    {
        if(p[i][0] == c)
        {
            if(p[i][2] == '$')
                add('$');
            else
                FIRST(p[i][2]);
        }
    }
}

void FOLLOW(char c)
{
    int i, j;

    if(p[0][0] == c)
        add('$');

    for(i = 0; i < n; i++)
    {
        for(j = 2; p[i][j] != '\0'; j++)
        {
            if(p[i][j] == c)
            {
                if(p[i][j + 1] != '\0')
                    FIRST(p[i][j + 1]);
                else if(p[i][0] != c)
                    FOLLOW(p[i][0]);
            }
        }
    }
}

int main()
{
    int i;
    char ch, choice;

    printf("Enter number of productions: ");
    scanf("%d", &n);

    for(i = 0; i < n; i++)
    {
        printf("Enter production %d: ", i + 1);
        scanf("%s", p[i]);
    }

    do
    {
        x = 0;

        printf("\nEnter symbol: ");
        scanf(" %c", &ch);

        FOLLOW(ch);

        printf("FOLLOW(%c) = { ", ch);

        for(i = 0; i < x; i++)
            printf("%c ", result[i]);

        printf("}\n");

        printf("Continue? (y/n): ");
        scanf(" %c", &choice);

    } while(choice == 'y' || choice == 'Y');

    return 0;
}
