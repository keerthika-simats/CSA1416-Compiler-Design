#include <stdio.h>

int main()
{
    char str[100];
    int words = 0, lines = 1, characters = 0;

    printf("Enter text (~ to end):\n");
    scanf("%[^~]", str);

    for(int i = 0; str[i] != '\0'; i++)
    {
        if(str[i] == ' ' || str[i] == '\t')
            words++;
        else if(str[i] == '\n')
            lines++;
        else
            characters++;
    }

    if(characters > 0)
        words++;

    printf("Words = %d\n", words);
    printf("Lines = %d\n", lines);
    printf("Characters = %d\n", characters);

    return 0;
}
