#include <stdio.h>
#include <string.h>

int main()
{
    char str[50];
    int i, a = 0, b = 0;

    printf("Grammar: S -> aS | Sb | ab\n");
    printf("Enter string: ");
    scanf("%s", str);

    for(i = 0; str[i] != '\0'; i++)
    {
        if(str[i] == 'a')
        {
            if(b)
            {
                printf("String not accepted");
                return 0;
            }
            a++;
        }
        else if(str[i] == 'b')
            b++;
        else
        {
            printf("String not accepted");
            return 0;
        }
    }

    if(a > 0 && b > 0)
        printf("String accepted");
    else
        printf("String not accepted");

    return 0;
}
