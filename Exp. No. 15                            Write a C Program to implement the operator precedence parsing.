#include <stdio.h>
#include <string.h>
#include <stdlib.h>

char input[50], stack[50];
int top = 0, i = 0, l;

char handles[][5] = {
    ")E(",
    "E*E",
    "E+E",
    "E-E",
    "E/E",
    "E^E",
    "i"
};

char prec[9][9] = {
    {'>','>','<','<','<','<','<','>','>'},
    {'>','>','<','<','<','<','<','>','>'},
    {'>','>','>','>','<','<','<','>','>'},
    {'>','>','>','>','<','<','<','>','>'},
    {'>','>','>','>','<','<','<','>','>'},
    {'>','>','>','>','>','e','e','>','>'},
    {'<','<','<','<','<','<','<','>','e'},
    {'>','>','>','>','>','e','e','>','>'},
    {'<','<','<','<','<','<','<','<','>'}
};

int index(char c)
{
    switch(c)
    {
        case '+': return 0;
        case '-': return 1;
        case '*': return 2;
        case '/': return 3;
        case '^': return 4;
        case 'i': return 5;
        case '(': return 6;
        case ')': return 7;
        case '$': return 8;
    }
    return -1;
}

void display()
{
    int j;
    for(j = 0; j <= top; j++)
        printf("%c", stack[j]);

    printf("\t");

    for(j = i; j < l; j++)
        printf("%c", input[j]);
}

int reduce()
{
    int j, k, len;

    for(j = 0; j < 7; j++)
    {
        len = strlen(handles[j]);

        if(top + 1 >= len)
        {
            for(k = 0; k < len; k++)
            {
                if(stack[top-k] != handles[j][len-1-k])
                    break;
            }

            if(k == len)
            {
                top = top - len + 1;
                stack[top] = 'E';
                stack[top+1] = '\0';

                printf("\tReduce E->%s", handles[j]);
                return 1;
            }
        }
    }

    return 0;
}

int main()
{
    printf("Enter expression using i: ");
    scanf("%s", input);

    strcat(input, "$");
    l = strlen(input);

    stack[0] = '$';
    stack[1] = '\0';

    printf("\nSTACK\tINPUT\tACTION\n");

    while(input[i] != '$')
    {
        stack[++top] = input[i++];
        stack[top+1] = '\0';

        display();
        printf("\tShift %c\n", input[i-1]);

        while(prec[index(stack[top])][index(input[i])] == '>')
        {
            if(!reduce())
                break;

            printf("\n");
            display();
            printf("\n");
        }
    }

    while(top > 1 && reduce());

    if(strcmp(stack, "$E") == 0)
        printf("\nAccepted\n");
    else
        printf("\nRejected\n");

    return 0;
}
