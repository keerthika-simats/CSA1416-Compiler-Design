#include <stdio.h>
#include <string.h>

int main()
{
    char exp[50];
    int i, t = 1;

    printf("Enter expression: ");
    scanf("%s", exp);

    printf("\nThree Address Code:\n");

    for (i = 0; exp[i] != '\0'; i++)
    {
        if (exp[i] == '*' || exp[i] == '/')
        {
            printf("t%d = %c %c %c\n",
                   t, exp[i-1], exp[i], exp[i+1]);

            exp[i+1] = '0' + t;
            t++;
        }
    }

    for (i = 0; exp[i] != '\0'; i++)
    {
        if (exp[i] == '+' || exp[i] == '-')
        {
            printf("t%d = %c %c %c\n",
                   t, exp[i-1], exp[i], exp[i+1]);

            exp[i+1] = '0' + t;
            t++;
        }
    }

    printf("Result = t%d\n", t - 1);

    return 0;
}
