#include <stdio.h>
#include <string.h>

int main()
{
    char op, arg1, arg2, result;

    printf("Enter expression (a+b): ");
    scanf("%c%c%c", &arg1, &op, &arg2);

    printf("\nThree Address Code:\n");
    printf("t1 = %c %c %c\n", arg1, op, arg2);

    printf("\nTarget Code:\n");
    printf("MOV R0, %c\n", arg1);

    if (op == '+')
        printf("ADD R0, %c\n", arg2);
    else if (op == '-')
        printf("SUB R0, %c\n", arg2);
    else if (op == '*')
        printf("MUL R0, %c\n", arg2);
    else if (op == '/')
        printf("DIV R0, %c\n", arg2);

    printf("MOV result, R0\n");

    return 0;
}
