#include <stdio.h>
#include <string.h>

char stack[50], input[50];
int top = -1, i = 0;

void push(char c)
{
    stack[++top] = c;
    stack[top + 1] = '\0';
}

void pop()
{
    stack[top--] = '\0';
}

int main()
{
    printf("Enter input string: ");
    scanf("%s", input);

    push('$');

    printf("\nStack\tInput\tAction\n");

    while (input[i] != '\0')
    {
        if (input[i] == 'i')
        {
            push('E');
            printf("%s\t%s\tReduce E->i\n", stack, input + i + 1);
        }
        else if (input[i] == '+' || input[i] == '*' ||
                 input[i] == '(' || input[i] == ')')
        {
            push(input[i]);
            printf("%s\t%s\tShift %c\n",
                   stack, input + i + 1, input[i]);
        }
        else
        {
            printf("Invalid symbol\n");
            return 0;
        }

        i++;
    }

    if (top >= 0)
        printf("\nString accepted.\n");
    else
        printf("\nString rejected.\n");

    return 0;
}
