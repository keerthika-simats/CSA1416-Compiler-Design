#include <stdio.h>
#include <stdlib.h>
#include <string.h>

char ip_sym[15], stack[15];
int ip_ptr = 0, st_ptr = 0, len, i;
char temp[2], temp2[2];
char act[15];

void check();

int main()
{
    printf("\n\tSHIFT REDUCE PARSER\n");

    printf("\nGRAMMAR\n");
    printf("\nE -> E+E");
    printf("\nE -> E/E");
    printf("\nE -> E*E");
    printf("\nE -> a/b");

    printf("\n\nEnter the input symbol: ");
    scanf("%s", ip_sym);

    printf("\n\tSTACK IMPLEMENTATION TABLE");
    printf("\nStack\t\tInput Symbol\t\tAction");

    printf("\n$\t\t%s$\t\t\t--", ip_sym);

    strcpy(act, "shift ");
    temp[0] = ip_sym[ip_ptr];
    temp[1] = '\0';
    strcat(act, temp);

    len = strlen(ip_sym);

    for (i = 0; i < len; i++)
    {
        stack[st_ptr] = ip_sym[ip_ptr];
        stack[st_ptr + 1] = '\0';

        ip_sym[ip_ptr] = ' ';
        ip_ptr++;

        printf("\n$%s\t\t%s$\t\t\t%s",
               stack, ip_sym, act);

        strcpy(act, "shift");
        temp[0] = ip_sym[ip_ptr];
        temp[1] = '\0';
        strcat(act, temp);

        check();
        st_ptr++;
    }

    st_ptr++;
    check();

    return 0;
}

void check()
{
    int flag = 0;

    temp2[0] = stack[st_ptr];
    temp2[1] = '\0';

    /* Reduce a or b to E */
    if (!strcmp(temp2, "a") || !strcmp(temp2, "b"))
    {
        stack[st_ptr] = 'E';

        if (!strcmp(temp2, "a"))
            printf("\n$%s\t\t%s$\t\t\tE->a",
                   stack, ip_sym);
        else
            printf("\n$%s\t\t%s$\t\t\tE->b",
                   stack, ip_sym);

        flag = 1;
    }

    /* Operators */
    if (!strcmp(temp2, "+") ||
        !strcmp(temp2, "*") ||
        !strcmp(temp2, "/"))
    {
        flag = 1;
    }

    /* Reduce E+E, E*E, E/E */
    if (!strcmp(stack, "E+E") ||
        !strcmp(stack, "E*E") ||
        !strcmp(stack, "E/E"))
    {
        if (!strcmp(stack, "E+E"))
            printf("\n$%s\t\t%s$\t\t\tE->E+E",
                   stack, ip_sym);
        else if (!strcmp(stack, "E*E"))
            printf("\n$%s\t\t%s$\t\t\tE->E*E",
                   stack, ip_sym);
        else
            printf("\n$%s\t\t%s$\t\t\tE->E/E",
                   stack, ip_sym);

        strcpy(stack, "E");
        st_ptr = 0;
        flag = 1;
    }

    /* Accept */
    if (!strcmp(stack, "E") && ip_ptr == len)
    {
        printf("\n$%s\t\t%s$\t\t\tACCEPT",
               stack, ip_sym);
        exit(0);
    }

    /* Reject */
    if (flag == 0)
    {
        printf("\n%s\t\t%s\t\tREJECT",
               stack, ip_sym);
        exit(0);
    }
}
