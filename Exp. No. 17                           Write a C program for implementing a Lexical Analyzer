#include <stdio.h>

int main()
{
    char str[100];
    int words = 0, lines = 0, characters = 0;

    printf("Enter text (~ to end):\n");
    scanf("%[^~]", str);

    for(int i = 0; str[i] != '\0'; i++)
    {
        if(str[i] == ' ' || str[i] == '\t')
            words++;
        else if(str[i] == '\n')
        {
            lines++;
            words++;
        }
        else
            characters++;
    }

    if(characters > 0)
    {
        words++;
        lines++;
    }

    printf("Total Words = %d\n", words);
    printf("Total Lines = %d\n", lines);
    printf("Total Characters = %d\n", characters);

    return 0;
}
